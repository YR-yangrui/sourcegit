<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SourceGit.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SourceGit.Views.CreateUnstagedChangeCategory"
             x:DataType="vm:CreateUnstagedChangeCategory">
  <StackPanel Orientation="Vertical" Margin="8,0">
    <StackPanel Orientation="Horizontal">
      <Path Width="16" Height="16" Data="{StaticResource Icons.Changes}"/>
      <TextBlock FontSize="18"
                 Margin="8,0,0,0"
                 Classes="bold"
                 Text="{DynamicResource Text.WorkingCopy.Unstaged.CreateCategory}"/>
    </StackPanel>

    <Grid Margin="0,16,0,0" RowDefinitions="32" ColumnDefinitions="120,*">
      <TextBlock Grid.Column="0"
                 HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,0,8,0"
                 Text="{DynamicResource Text.WorkingCopy.Unstaged.Category}"/>
      <TextBox Grid.Column="1"
               Height="26"
               VerticalAlignment="Center"
               CornerRadius="3"
               Text="{Binding Name, Mode=TwoWay}"/>
    </Grid>
  </StackPanel>
</UserControl>
